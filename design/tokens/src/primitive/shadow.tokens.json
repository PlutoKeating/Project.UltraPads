{
  "shadow": {
    "$type": "shadow",
    "none": { "$value": [] },
    "sm": { "$value": [{ "color": "{color.alpha.black.20}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 3, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }] },
    "md": { "$value": [{ "color": "{color.alpha.black.50}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 12, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }] },
    "lg": { "$value": [{ "color": "{color.alpha.black.63}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 10, "unit": "px" }, "blur": { "value": 28, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }], "$description": "Floating kit cards / track card (SHOT)" },
    "padBevel": { "$value": [{ "color": "{color.alpha.black.50}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 3, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }], "$description": "Hard bottom edge under neon pads (SHOT)" }
  },
  "glow": {
    "$type": "shadow",
