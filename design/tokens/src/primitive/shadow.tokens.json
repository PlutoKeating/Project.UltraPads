    "none": { "$value": [] },
    "sm": { "$value": [{ "color": "#FFFFFF8C", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 8, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }] },
    "md": { "$value": [
      { "color": "#FFFFFFA6", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 12, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
      { "color": "#FFFFFF4D", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 28, "unit": "px" }, "spread": { "value": 2, "unit": "px" } }
    ] },
    "lg": { "$value": [
      { "color": "#FFFFFFBF", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 16, "unit": "px" }, "spread": { "value": 1, "unit": "px" } },
      { "color": "#FFFFFF59", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 40, "unit": "px" }, "spread": { "value": 6, "unit": "px" } }
    ] }
