{
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": { "value": 0, "unit": "ms" } },
      "xfast": { "$value": { "value": 50, "unit": "ms" } },
      "fast": { "$value": { "value": 100, "unit": "ms" }, "$description": "APK A/B page scroll; material buttons/chips" },
      "quick": { "$value": { "value": 150, "unit": "ms" }, "$description": "APK bottom sheet slide" },
      "padPressHalf": { "$value": { "value": 158, "unit": "ms" }, "$description": "APK one-shot Lottie first half (frames 0..9.5 @60fps)" },
      "medium": { "$value": { "value": 200, "unit": "ms" }, "$description": "APK unzip delay" },
      "loopFlash": { "$value": { "value": 250, "unit": "ms" }, "$description": "APK loop flash peak (frame 15)" },
      "slow": { "$value": { "value": 300, "unit": "ms" }, "$description": "APK panel/sub-page enter & exit" },
      "padPress": { "$value": { "value": 317, "unit": "ms" }, "$description": "APK one-shot Lottie total (19 frames @60fps)" },
      "recTransition": { "$value": { "value": 367, "unit": "ms" }, "$description": "APK bt_rec_transition" },
      "slower": { "$value": { "value": 450, "unit": "ms" } },
      "loopFlashCycle": { "$value": { "value": 500, "unit": "ms" }, "$description": "APK loop flash back to 0 (frame 30)" },
      "loopRevolution": { "$value": { "value": 817, "unit": "ms" }, "$description": "APK loop icon one revolution (49 frames)" },
      "loadingKit": { "$value": { "value": 868, "unit": "ms" } },
      "pulse": { "$value": { "value": 900, "unit": "ms" } },
      "progress": { "$value": { "value": 1250, "unit": "ms" }, "$description": "APK loading progress bar" },
      "recLoop": { "$value": { "value": 2000, "unit": "ms" }, "$description": "APK bt_rec_animation loop" },
      "download": { "$value": { "value": 2202, "unit": "ms" } },
      "toast": { "$value": { "value": 2500, "unit": "ms" } },
      "carousel": { "$value": { "value": 4000, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "linear": { "$value": [0, 0, 1, 1] },
      "standard": { "$value": [0.42, 0, 0.58, 1], "$description": "Android AccelerateDecelerate (APK default for panels)" },
      "decelerate": { "$value": [0, 0, 0.2, 1], "$description": "Android Decelerate (APK A/B scroll, progress)" },
      "accelerate": { "$value": [0.4, 0, 1, 1] },
      "emphasized": { "$value": [0.2, 0, 0, 1] },
      "lottiePad": { "$value": [0.6, 0, 0.4, 1], "$description": "APK pad flash Lottie bezier (o.x 0.6, i.x 0.4)" },
      "lottieLinear": { "$value": [0.167, 0.167, 0.833, 0.833], "$description": "APK loop Lottie" }
    },
    "spring": {
      "$type": "number",
      "$description": "Physics springs -> Flutter SpringDescription(mass, stiffness, damping).",
      "snappy": { "stiffness": { "$value": 900 }, "damping": { "$value": 38 }, "mass": { "$value": 1 } },
      "standard": { "stiffness": { "$value": 500 }, "damping": { "$value": 36 }, "mass": { "$value": 1 } },
      "gentle": { "stiffness": { "$value": 170 }, "damping": { "$value": 26 }, "mass": { "$value": 1 } },
      "bouncy": { "stiffness": { "$value": 400 }, "damping": { "$value": 16 }, "mass": { "$value": 1 } }
    }
  }
}
