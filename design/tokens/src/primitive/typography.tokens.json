{
  "font": {
    "family": {
      "$type": "fontFamily",
      "$description": "IPA 4.7.0 ships Open Sans (OFL, bundled in up_tokens) and aliases the old Uni Sans names onto it. Uni Sans (commercial, APK 3.7.6) stays available as an optional skin font injected from private-assets.",
      "regular": { "$value": ["Open Sans"], "$description": "IPA OpenSans-Regular (alias Uni Sans / UniSansRegular)" },
      "heavy": { "$value": ["Open Sans"], "$description": "IPA OpenSans-ExtraBold (alias UniSansHeavy)" },
      "light": { "$value": ["Open Sans"], "$description": "IPA OpenSans-Light (alias UniSansThin)" },
      "uniSansRegular": { "$value": ["Uni Sans"], "$description": "Optional private skin font (APK 3.7.6)" },
      "uniSansHeavy": { "$value": ["Uni Sans Heavy"], "$description": "Optional private skin font (APK 3.7.6)" },
      "uniSansThin": { "$value": ["Uni Sans Thin"], "$description": "Optional private skin font (APK 3.7.6)" }
    },
    "weight": {
      "$type": "fontWeight",
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "heavy": { "$value": 800, "$description": "Open Sans ExtraBold" }
    },
    "size": {
      "$type": "dimension",
      "$description": "IPA FairyGUI sizes / 2 (design px -> pt).",
      "xxxs": { "$value": { "value": 10, "unit": "px" }, "$description": "UP small overline (IMPORT FROM); not measured" },
      "xxs": { "$value": { "value": 11.5, "unit": "px" }, "$description": "IPA INSPIRED BY 23px" },
      "xs": { "$value": { "value": 12.5, "unit": "px" }, "$description": "IPA SONGS button / small buttons 25px" },
      "sm": { "$value": { "value": 14, "unit": "px" }, "$description": "IPA buttons 28px" },
      "md": { "$value": { "value": 14.5, "unit": "px" }, "$description": "IPA KIT + name 29px" },
      "lg": { "$value": { "value": 15, "unit": "px" }, "$description": "IPA first-open bubble 30px" },
      "xl": { "$value": { "value": 16, "unit": "px" }, "$description": "IPA LOAD SOUND title 32px" },
      "xxl": { "$value": { "value": 17, "unit": "px" }, "$description": "IPA library section title 34px" },
      "xxxl": { "$value": { "value": 17.5, "unit": "px" }, "$description": "IPA kit row title 35px" },
      "page": { "$value": { "value": 18, "unit": "px" }, "$description": "IPA page title 36px" },
      "speed": { "$value": { "value": 19, "unit": "px" }, "$description": "IPA speed digits 38px" },
      "value": { "$value": { "value": 24, "unit": "px" }, "$description": "IPA edit pad numeric values 48px" },
      "bank": { "$value": { "value": 30, "unit": "px" }, "$description": "IPA A/B letter 60px; paywall title 60px" },
      "display": { "$value": { "value": 35, "unit": "px" }, "$description": "IPA rate dialog title 70px" }
    },
    "letterSpacing": {
      "$type": "dimension",
      "$description": "FairyGUI texts use no extra tracking.",
      "tight": { "$value": { "value": -0.2, "unit": "px" } },
      "none": { "$value": { "value": 0, "unit": "px" } },
      "caps": { "$value": { "value": 0, "unit": "px" }, "$description": "All-caps labels (IPA: no extra tracking)" },
      "capsWide": { "$value": { "value": 0.5, "unit": "px" }, "$description": "UP: tiny all-caps overlines" }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.0 },
      "snug": { "$value": 1.15 },
      "normal": { "$value": 1.3 },
      "relaxed": { "$value": 1.5 }
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "Text roles. $extensions.up.textCase = upper -> role renders upper-case (locale-aware); ARB strings stay in natural case.",
    "hero": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.bank}", "letterSpacing": "{font.letterSpacing.tight}", "lineHeight": "{font.lineHeight.tight}" }, "$description": "IPA walkthrough / paywall title", "$extensions": { "up": { "textCase": "upper" } } },
    "display": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.display}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.tight}" }, "$description": "IPA rate dialog title" },
    "headline": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.page}", "letterSpacing": "{font.letterSpacing.caps}", "lineHeight": "{font.lineHeight.snug}" }, "$description": "IPA page title (KITS)", "$extensions": { "up": { "textCase": "upper" } } },
    "title": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.xxxl}", "letterSpacing": "{font.letterSpacing.caps}", "lineHeight": "{font.lineHeight.snug}" }, "$description": "IPA kit row song title", "$extensions": { "up": { "textCase": "upper" } } },
    "titleSm": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.md}", "letterSpacing": "{font.letterSpacing.caps}", "lineHeight": "{font.lineHeight.snug}" }, "$description": "IPA top bar kit name", "$extensions": { "up": { "textCase": "upper" } } },
    "section": { "$value": { "fontFamily": "{font.family.regular}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.xxl}", "letterSpacing": "{font.letterSpacing.caps}", "lineHeight": "{font.lineHeight.snug}" }, "$description": "IPA library section title (use text.section colour)", "$extensions": { "up": { "textCase": "upper" } } },
    "sheetTitle": { "$value": { "fontFamily": "{font.family.regular}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.xl}", "letterSpacing": "{font.letterSpacing.caps}", "lineHeight": "{font.lineHeight.snug}" }, "$description": "IPA LOAD SOUND / EDIT PAD header", "$extensions": { "up": { "textCase": "upper" } } },
    "label": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.sm}", "letterSpacing": "{font.letterSpacing.caps}", "lineHeight": "{font.lineHeight.snug}" }, "$extensions": { "up": { "textCase": "upper" } } },
    "labelSm": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.xs}", "letterSpacing": "{font.letterSpacing.caps}", "lineHeight": "{font.lineHeight.snug}" }, "$description": "IPA SONGS button", "$extensions": { "up": { "textCase": "upper" } } },
    "overline": { "$value": { "fontFamily": "{font.family.regular}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.xxxs}", "letterSpacing": "{font.letterSpacing.capsWide}", "lineHeight": "{font.lineHeight.snug}" }, "$extensions": { "up": { "textCase": "upper" } } },
    "inspired": { "$value": { "fontFamily": "{font.family.regular}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.xxs}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.snug}" }, "$description": "IPA INSPIRED BY (colour text.secondary = white 60%)", "$extensions": { "up": { "textCase": "upper" } } },
    "body": { "$value": { "fontFamily": "{font.family.regular}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.sm}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.normal}" } },
    "bodySm": { "$value": { "fontFamily": "{font.family.regular}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.xs}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.normal}" } },
    "caption": { "$value": { "fontFamily": "{font.family.regular}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.xxs}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.normal}" } },
    "button": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.sm}", "letterSpacing": "{font.letterSpacing.caps}", "lineHeight": "{font.lineHeight.tight}" }, "$description": "IPA buttons 25-28px", "$extensions": { "up": { "textCase": "upper" } } },
    "tab": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.xs}", "letterSpacing": "{font.letterSpacing.caps}", "lineHeight": "{font.lineHeight.tight}" }, "$extensions": { "up": { "textCase": "upper" } } },
    "bubble": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.lg}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.snug}" }, "$description": "IPA first-open guide bubble (black on white)", "$extensions": { "up": { "textCase": "upper" } } },
    "padBank": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.bank}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.tight}" }, "$description": "IPA A/B letter", "$extensions": { "up": { "textCase": "upper" } } },
    "padNumber": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.xl}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.tight}" }, "$description": "Design-time default; runtime size = pad width * ratio.padNumberSize.", "$extensions": { "up": { "textCase": "upper" } } },
    "numeric": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.speed}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.tight}" }, "$description": "IPA speed 1.0 (colour transport.speedText)" },
    "value": { "$value": { "fontFamily": "{font.family.regular}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.value}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.tight}" }, "$description": "IPA edit pad VOLUME / PITCH / GROUP values" }
  }
}
