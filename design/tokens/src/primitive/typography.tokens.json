{
  "font": {
    "family": {
      "$type": "fontFamily",
      "$description": "Uni Sans (Fontfabric) is commercial: never committed. Injected from private-assets at build time; Montserrat (OFL, bundled in up_tokens) is the fallback.",
      "regular": { "$value": ["Uni Sans", "Montserrat"], "$description": "APK Calligraphy global default" },
      "heavy": { "$value": ["Uni Sans Heavy", "Montserrat"], "$description": "Titles, buttons, pad numbers" },
      "thin": { "$value": ["Uni Sans Thin", "Montserrat"], "$description": "INSPIRED BY" }
    },
    "weight": {
      "$type": "fontWeight",
      "$description": "Weights used when rendering with the fallback family (the private Uni Sans cuts are single-weight families).",
      "thin": { "$value": 100 },
      "regular": { "$value": 400 },
      "heavy": { "$value": 800 }
    },
    "size": {
      "$type": "dimension",
      "xxxs": { "$value": { "value": 8, "unit": "px" }, "$description": "APK INSPIRED BY" },
      "xxs": { "$value": { "value": 9, "unit": "px" } },
      "xs": { "$value": { "value": 10, "unit": "px" } },
      "sm": { "$value": { "value": 12, "unit": "px" }, "$description": "APK kit name" },
      "md": { "$value": { "value": 14, "unit": "px" } },
      "lg": { "$value": { "value": 15, "unit": "px" }, "$description": "APK body max" },
      "xl": { "$value": { "value": 16, "unit": "px" }, "$description": "APK title / A-B button" },
      "xxl": { "$value": { "value": 20, "unit": "px" } },
      "xxxl": { "$value": { "value": 24, "unit": "px" } },
      "display": { "$value": { "value": 32, "unit": "px" } },
      "hero": { "$value": { "value": 44, "unit": "px" } }
    },
    "letterSpacing": {
      "$type": "dimension",
      "tight": { "$value": { "value": -0.2, "unit": "px" } },
      "none": { "$value": { "value": 0, "unit": "px" } },
      "caps": { "$value": { "value": 0.5, "unit": "px" }, "$description": "All-caps labels" },
      "capsWide": { "$value": { "value": 1.2, "unit": "px" }, "$description": "All-caps overlines" }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.0 },
      "snug": { "$value": 1.15 },
      "normal": { "$value": 1.3 },
      "relaxed": { "$value": 1.5 }
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "Text roles. $extensions.up.textCase = upper means the role renders upper-case (locale-aware) — ARB strings stay in natural case.",
    "hero": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.hero}", "letterSpacing": "{font.letterSpacing.tight}", "lineHeight": "{font.lineHeight.tight}" } },
    "display": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.display}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.tight}" }, "$extensions": { "up": { "textCase": "upper" } } },
    "headline": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.xxxl}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.snug}" }, "$extensions": { "up": { "textCase": "upper" } } },
    "title": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.xl}", "letterSpacing": "{font.letterSpacing.caps}", "lineHeight": "{font.lineHeight.snug}" }, "$extensions": { "up": { "textCase": "upper" } } },
    "titleSm": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.md}", "letterSpacing": "{font.letterSpacing.caps}", "lineHeight": "{font.lineHeight.snug}" }, "$extensions": { "up": { "textCase": "upper" } } },
    "label": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.sm}", "letterSpacing": "{font.letterSpacing.caps}", "lineHeight": "{font.lineHeight.snug}" }, "$extensions": { "up": { "textCase": "upper" } } },
    "labelSm": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.xs}", "letterSpacing": "{font.letterSpacing.caps}", "lineHeight": "{font.lineHeight.snug}" }, "$extensions": { "up": { "textCase": "upper" } } },
    "overline": { "$value": { "fontFamily": "{font.family.regular}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.xxxs}", "letterSpacing": "{font.letterSpacing.capsWide}", "lineHeight": "{font.lineHeight.snug}" }, "$extensions": { "up": { "textCase": "upper" } } },
    "inspired": { "$value": { "fontFamily": "{font.family.thin}", "fontWeight": "{font.weight.thin}", "fontSize": "{font.size.xxxs}", "letterSpacing": "{font.letterSpacing.capsWide}", "lineHeight": "{font.lineHeight.snug}" }, "$extensions": { "up": { "textCase": "upper" } } },
    "body": { "$value": { "fontFamily": "{font.family.regular}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.md}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.normal}" } },
    "bodySm": { "$value": { "fontFamily": "{font.family.regular}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.sm}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.normal}" } },
    "caption": { "$value": { "fontFamily": "{font.family.regular}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.xs}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.normal}" } },
    "button": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.md}", "letterSpacing": "{font.letterSpacing.caps}", "lineHeight": "{font.lineHeight.tight}" }, "$extensions": { "up": { "textCase": "upper" } } },
    "tab": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.xs}", "letterSpacing": "{font.letterSpacing.caps}", "lineHeight": "{font.lineHeight.tight}" }, "$extensions": { "up": { "textCase": "upper" } } },
    "padBank": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.xl}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.tight}" }, "$extensions": { "up": { "textCase": "upper" } } },
    "padNumber": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.xl}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.tight}" }, "$description": "fontSize is a design-time default; runtime size = pad width * ratio.padNumberSize.", "$extensions": { "up": { "textCase": "upper" } } },
    "numeric": { "$value": { "fontFamily": "{font.family.heavy}", "fontWeight": "{font.weight.heavy}", "fontSize": "{font.size.sm}", "letterSpacing": "{font.letterSpacing.none}", "lineHeight": "{font.lineHeight.tight}" } }
  }
}
