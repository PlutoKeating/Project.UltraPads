{
  "pad": {
    "palette": {
      "$type": "color",
      "$description": "Ordered pad colour roles; Kits store a role index (wraps modulo the palette length), never RGB. Roles 0-3 = Kit config colours rosa / amarelo / verde / azul(_loop) (pink / orange / green / blue, Ref). Roles 4-7 are UltraPads extensions (store-screenshot neon hues). Each role: core (gradient stop 0 / radial centre), mid (0.5 / flat body), edge (1 / rim), glow, pressed (colour of the press / loop flash layer).",
      "0": {
        "core": {
          "$value": "{color.pad.pink.highlight}"
        },
        "mid": {
          "$value": "{color.pad.pink.base}"
        },
        "edge": {
          "$value": "{color.pad.pink.base}"
        },
        "glow": {
          "$value": "{color.pad.pink.base}"
        },
        "pressed": {
          "$value": "{color.base.white}"
        }
      },
      "1": {
        "core": {
          "$value": "{color.pad.orange.highlight}"
        },
        "mid": {
          "$value": "{color.pad.orange.base}"
        },
        "edge": {
          "$value": "{color.pad.orange.bitmap}"
        },
        "glow": {
          "$value": "{color.pad.orange.base}"
        },
        "pressed": {
          "$value": "{color.base.white}"
        }
      },
      "2": {
        "core": {
          "$value": "{color.pad.green.highlight}"
        },
        "mid": {
          "$value": "{color.pad.green.base}"
        },
        "edge": {
          "$value": "{color.pad.green.base}"
        },
        "glow": {
          "$value": "{color.pad.green.base}"
        },
        "pressed": {
          "$value": "{color.base.white}"
        }
      },
      "3": {
        "core": {
          "$value": "{color.pad.blue.highlight}"
        },
        "mid": {
          "$value": "{color.pad.blue.base}"
        },
        "edge": {
          "$value": "{color.pad.blue.base}"
        },
        "glow": {
          "$value": "{color.pad.blue.base}"
        },
        "pressed": {
          "$value": "{color.base.white}"
        }
      },
      "4": {
        "core": {
          "$value": "{color.neon.magenta.300}"
        },
        "mid": {
          "$value": "{color.neon.magenta.500}"
        },
        "edge": {
          "$value": "{color.neon.magenta.700}"
        },
        "glow": {
          "$value": "{color.neon.magenta.500}"
        },
        "pressed": {
          "$value": "{color.base.white}"
        }
      },
      "5": {
        "core": {
          "$value": "{color.neon.yellow.300}"
        },
        "mid": {
          "$value": "{color.neon.yellow.500}"
        },
        "edge": {
          "$value": "{color.neon.yellow.700}"
        },
        "glow": {
          "$value": "{color.neon.yellow.500}"
        },
        "pressed": {
          "$value": "{color.base.white}"
        }
      },
      "6": {
        "core": {
          "$value": "{color.neon.cyan.300}"
        },
        "mid": {
          "$value": "{color.neon.cyan.500}"
        },
        "edge": {
          "$value": "{color.neon.cyan.700}"
        },
        "glow": {
          "$value": "{color.neon.cyan.500}"
        },
        "pressed": {
          "$value": "{color.base.white}"
        }
      },
      "7": {
        "core": {
          "$value": "{color.skin.halloween.purple.core}"
        },
        "mid": {
          "$value": "{color.skin.halloween.purple.mid}"
        },
        "edge": {
          "$value": "{color.skin.halloween.purple.edge}"
        },
        "glow": {
          "$value": "{color.skin.halloween.purple.mid}"
        },
        "pressed": {
          "$value": "{color.base.white}"
        }
      }
    },
    "shape": {
      "radiusRatio": {
        "$type": "number",
        "$value": "{ratio.padRadius}",
        "$description": "Corner radius = pad short side * ratio (Ref ~10%; Circle skin 0.5)"
      }
    },
    "fill": {
      "radial": {
        "$type": "number",
        "$value": 1,
        "$description": "1 = radial (core centre), 0 = linear top->bottom (core = top highlight); lerpable"
      }
    },
    "showNumber": {
      "$type": "number",
      "$value": 0,
      "$description": "1 = draw the pad number (Ref Number skin)"
    },
    "flash": {
      "$type": "color",
      "$value": "{color.base.white}",
      "$description": "Default flash colour (Ref white overlay). Per-role colour: pad.palette.<i>.pressed."
    },
    "border": {
      "$type": "color",
      "$value": "{color.grey.930}"
    },
    "label": {
      "$type": "color",
      "$value": "{color.base.white}"
    },
    "idle": {
      "fillOpacity": {
        "$type": "number",
        "$value": 1
      },
      "borderWidth": {
        "$type": "dimension",
        "$value": "{borderWidth.none}"
      },
      "glow": {
        "$type": "number",
        "$value": 0
      },
      "bevel": {
        "$type": "number",
        "$value": 1,
        "$description": "Strength of the hard bottom bevel shadow (SHOT)"
      }
    },
    "pressed": {
      "fillOpacity": {
        "$type": "number",
        "$value": 1
      },
      "flashOpacity": {
        "$type": "number",
        "$value": "{opacity.flash}",
        "$description": "Peak alpha of the palette 'pressed' layer (Ref white overlay 0.8; tint-swap skins use 1)"
      },
      "glow": {
        "$type": "number",
        "$value": 1,
        "$description": "UP neon glow (the original has no glow)"
      },
      "scale": {
        "$type": "number",
        "$value": 1,
        "$description": "Ref Default does not scale; Circle / Square skins 0.9"
      }
    },
    "playing": {
      "fillOpacity": {
        "$type": "number",
        "$value": 1
      },
      "flashOpacity": {
        "$type": "number",
        "$value": "{opacity.flash}",
        "$description": "Ref loop flash peak (yoyo 0 <-> 0.8)"
      },
      "glow": {
        "$type": "number",
        "$value": 0.8
      }
    },
    "pending": {
      "opacityMin": {
        "$type": "number",
        "$value": 0.4,
        "$description": "UP: blink floor while a loop waits for its quantised start"
      }
    },
    "disabled": {
      "opacity": {
        "$type": "number",
        "$value": "{opacity.disabled}"
      }
    },
    "selected": {
      "border": {
        "$type": "color",
        "$value": "{color.base.white}"
      },
      "borderWidth": {
        "$type": "dimension",
        "$value": "{borderWidth.regular}"
      }
    },
    "loop": {
      "idleFill": {
        "$type": "color",
        "$value": "{color.neon.violet.500}",
        "$description": "SHOT idle loop pad body (used when idle.fillOpacity < 1)"
      },
      "idleFillOpacity": {
        "$type": "number",
        "$value": 0
      },
      "borderWidth": {
        "$type": "dimension",
        "$value": "{borderWidth.none}"
      },
      "icon": {
        "$type": "color",
        "$value": "{color.base.white}",
        "$description": "Ref loop glyph (white, α ~0.58 in Default bitmap)"
      },
      "iconOpacity": {
        "$type": "number",
        "$value": 0.58
      }
    },
    "empty": {
      "fill": {
        "$type": "gradient",
        "$value": "{gradient.emptyPad}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.base.white}",
        "$description": "Ref dashed rounded frame"
      },
      "opacity": {
        "$type": "number",
        "$value": "{opacity.emptyPad}",
        "$description": "Ref empty pad frame alpha 0.2"
      }
    },
    "tutorial": {
      "dimOpacity": {
        "$type": "number",
        "$value": "{opacity.dim}",
        "$description": "Old ref non-target pad alpha"
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.base.white}"
      },
      "fill": {
        "$type": "color",
        "$value": "{color.ui.tutorialFill}",
        "$description": "Ref tutorial pad fill (fills bottom->top in 1 s)"
      },
      "outline": {
        "$type": "color",
        "$value": "{color.ui.tutorialOutline}"
      },
      "loopIcon": {
        "$type": "color",
        "$value": "{color.ui.tutorialLoop}"
      }
    }
  }
}
