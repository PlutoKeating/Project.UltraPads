{
  "$description": "Semantic layer — base values (identical to the neon skin). Themes override these paths only. Allowed $type: color | gradient | number | dimension.",
  "surface": {
    "$type": "color",
    "app": {
      "$value": "{color.ui.bgPads}",
      "$description": "IPA nav bars / window"
    },
    "pads": {
      "$value": "{color.ui.bgPads}",
      "$description": "IPA perform page"
    },
    "page": {
      "$value": "{color.ui.bgMenu}",
      "$description": "IPA library / search / save-kit pages"
    },
    "raised": {
      "$value": "{color.ui.cell}",
      "$description": "IPA list rows"
    },
    "raisedHigh": {
      "$value": "{color.ui.modalButton}",
      "$description": "IPA secondary modal button / action sheet"
    },
    "sunken": {
      "$value": "{color.ui.placeholder}",
      "$description": "IPA placeholders / wells"
    },
    "toolbar": {
      "$value": "{color.ui.bgPads}",
      "$description": "IPA function button row"
    },
    "bankButton": {
      "$value": "{color.ui.bgPads}",
      "$description": "IPA A/B button"
    },
    "padContainer": {
      "$value": "{color.ui.bgPads}"
    },
    "scrim": {
      "$value": "{color.alpha.black.70}",
      "$description": "IPA tutorial / full-page overlay 70%"
    },
    "dim": {
      "$value": "{color.alpha.black.50}",
      "$description": "IPA info overlay 50%"
    },
    "overlayDownload": {
      "$value": "{color.alpha.black.67}"
    },
    "scrimStrong": {
      "$value": "{color.alpha.black.80}",
      "$description": "IPA kit preview overlay 80%"
    },
    "kitEditor": {
      "$value": "{color.brand.create}",
      "$description": "IPA kit editor page background"
    },
    "social": {
      "$value": "{color.ui.social}",
      "$description": "IPA social bar"
    },
    "tabBar": {
      "$value": "{color.ui.bgMenu}",
      "$description": "IPA tab bar"
    },
    "navShadow": {
      "$value": "{color.alpha.black.60}",
      "$description": "IPA nav bar shadow"
    }
  },
  "border": {
    "$type": "color",
    "subtle": {
      "$value": "{color.alpha.white.10}",
      "$description": "IPA dividers (white 10%)"
    },
    "default": {
      "$value": "{color.alpha.white.12}"
    },
    "strong": {
      "$value": "{color.alpha.white.30}"
    },
    "divider": {
      "$value": "{color.alpha.white.10}",
      "$description": "IPA tab bar top line / list separators"
    },
    "inverse": {
      "$value": "{color.base.white}"
    },
    "dark": {
      "$value": "{color.alpha.black.40}",
      "$description": "IPA kit editor separator"
    }
  },
  "text": {
    "$type": "color",
    "primary": {
      "$value": "{color.base.white}"
    },
    "secondary": {
      "$value": "{color.alpha.white.60}",
      "$description": "IPA INSPIRED BY α0.6"
    },
    "muted": {
      "$value": "{color.ui.textSection}",
      "$description": "IPA section titles"
    },
    "faint": {
      "$value": "{color.grey.500}"
    },
    "disabled": {
      "$value": "{color.alpha.white.30}"
    },
    "inverse": {
      "$value": "{color.grey.850}"
    },
    "onAccent": {
      "$value": "{color.base.white}"
    },
    "link": {
      "$value": "{color.brand.pink}"
    },
    "section": {
      "$value": "{color.ui.textSection}",
      "$description": "IPA library section titles"
    },
    "dark": {
      "$value": "{color.ui.textDark}",
      "$description": "IPA dark text on white buttons"
    }
  },
  "icon": {
    "$type": "color",
    "primary": {
      "$value": "{color.base.white}"
    },
    "secondary": {
      "$value": "{color.grey.400}"
    },
    "disabled": {
      "$value": "{color.alpha.white.30}"
    },
    "onAccent": {
      "$value": "{color.base.white}"
    }
  },
  "accent": {
    "$type": "color",
    "primary": {
      "$value": "{color.brand.pink}",
      "$description": "IPA #FD1A68 main accent"
    },
    "primaryPressed": {
      "$value": "{color.brand.rose}"
    },
    "primaryMuted": {
      "$value": "{color.brand.raspberryDeep}"
    },
    "selected": {
      "$value": "{color.brand.rosePad}",
      "$description": "IPA genre check / skin price"
    },
    "secondary": {
      "$value": "{color.brand.rose}",
      "$description": "IPA divider under skin panel title, SAVE text, input focus"
    },
    "preview": {
      "$value": "{color.swatch.aquaMarine}"
    },
    "alert": {
      "$value": "{color.brand.alert}",
      "$description": "IPA NO / CANCEL outline"
    },
    "create": {
      "$value": "{color.brand.create}",
      "$description": "IPA kit editor accent"
    }
  },
  "status": {
    "$type": "color",
    "success": {
      "$value": "{color.ui.perfect}",
      "$description": "IPA PERFECT feedback"
    },
    "warning": {
      "$value": "{color.swatch.dandelion}"
    },
    "danger": {
      "$value": "{color.ui.recRed}",
      "$description": "IPA wrong-pad cross"
    },
    "info": {
      "$value": "{color.swatch.skyBlue}"
    },
    "recording": {
      "$value": "{color.ui.recRed}",
      "$description": "IPA record button / timer"
    }
  },
  "brand": {
    "background": {
      "$type": "gradient",
      "$value": "{gradient.brand}"
    }
  },
  "focus": {
    "ring": {
      "$type": "color",
      "$value": "{color.base.white}"
    },
    "ringWidth": {
      "$type": "dimension",
      "$value": "{borderWidth.regular}"
    }
  },
  "feedback": {
    "$type": "color",
    "perfect": {
      "$value": "{color.ui.perfect}",
      "$description": "IPA PERFECT circle"
    },
    "wrong": {
      "$value": "{color.ui.recRed}",
      "$description": "IPA wrong cross"
    },
    "bubble": {
      "$value": "{color.base.white}",
      "$description": "IPA first-open bubble"
    },
    "bubbleText": {
      "$value": "{color.base.black}"
    }
  }
}
