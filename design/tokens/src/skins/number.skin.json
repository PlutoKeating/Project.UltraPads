{
  "$description": "Skin preset \"Number\" as semantic overrides. Default + pad number layer.",
  "id": "number",
  "order": 2,
  "nameKey": "skinPresetNumber",
  "base": "neon",
  "technique": "overlay",
  "fidelity": "full",
  "overrides": {
    "pad.palette.0.core": "{color.pad.pink.highlight}",
    "pad.palette.0.mid": "{color.pad.pink.base}",
    "pad.palette.0.edge": "{color.pad.pink.base}",
    "pad.palette.0.glow": "{color.pad.pink.base}",
    "pad.palette.0.pressed": "{color.base.white}",
    "pad.palette.1.core": "{color.pad.orange.highlight}",
    "pad.palette.1.mid": "{color.pad.orange.base}",
    "pad.palette.1.edge": "{color.pad.orange.base}",
    "pad.palette.1.glow": "{color.pad.orange.base}",
    "pad.palette.1.pressed": "{color.base.white}",
    "pad.palette.2.core": "{color.pad.green.highlight}",
    "pad.palette.2.mid": "{color.pad.green.base}",
    "pad.palette.2.edge": "{color.pad.green.base}",
    "pad.palette.2.glow": "{color.pad.green.base}",
    "pad.palette.2.pressed": "{color.base.white}",
    "pad.palette.3.core": "{color.pad.blue.highlight}",
    "pad.palette.3.mid": "{color.pad.blue.base}",
    "pad.palette.3.edge": "{color.pad.blue.base}",
    "pad.palette.3.glow": "{color.pad.blue.base}",
    "pad.palette.3.pressed": "{color.base.white}",
    "pad.pressed.glow": 0,
    "pad.playing.glow": 0,
    "pad.fill.radial": 0,
    "pad.pressed.flashOpacity": "{opacity.flash}",
    "pad.playing.flashOpacity": "{opacity.flash}",
    "pad.showNumber": 1
  }
}
