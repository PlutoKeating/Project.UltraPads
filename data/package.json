{
  "name": "ultrapads-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UltraPads 数据服务：官方曲库目录、.upkit 文件存储与账号数据（收藏、最近使用、下载记录）",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "ULTRAPADS_DATA_DIR=./.dev ULTRAPADS_DATA_KEY=dev-key-dev-key-dev-key-dev-key-0000 ULTRAPADS_ADMIN_KEY=dev-admin-dev-admin-dev-admin-0000 ULTRAPADS_DATA_PORT=8791 node --disable-warning=ExperimentalWarning --watch src/main.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
