# ultrapads-data 的配置。./start.sh 第一次运行时复制为 .env（权限 600）并生成密钥；.env 不入库。

# 自动生成：Worker 访问这里用的服务密钥（Worker 的 Secret ULTRAPADS_DATA_KEY 要与它相同）。不要泄露；更换后两边同时改。
ULTRAPADS_DATA_KEY=
# 自动生成：运营接口（/v1/admin/*）的密钥，只给目录管线使用，Worker 不持有。
ULTRAPADS_ADMIN_KEY=
# 本机端口：只发布到 127.0.0.1，由已有的反向隧道转发（路径前缀 /ultrapads）
ULTRAPADS_DATA_LOCAL_PORT=8791
# 可选：npm 镜像源（服务器连 npmjs.org 慢时）
NPM_REGISTRY=https://registry.npmjs.org
