{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrapads.dev/schema/manifest-1.json",
  "title": "UltraPads .upkit manifest.json 1.x",
  "description": "包元数据 + 每个文件的 BLAKE3 与大小。读取方必须在加载前校验哈希。",
  "type": "object",
  "required": ["mediaType", "formatVersion", "id", "name", "files"],
  "properties": {
    "mediaType": { "type": "string" },
    "formatVersion": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,2}([-+].*)?$" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "authors": { "type": "array", "items": { "type": "string" } },
    "license": { "type": "string", "description": "SPDX 许可证表达式，或 NOASSERTION" },
    "generator": { "type": "string" },
    "created": { "type": "string" },
    "updated": { "type": "string" },
    "genres": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string" },
        "originalId": { "type": "string" },
        "originalName": { "type": "string" },
        "inspiredBy": { "type": "string" }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size", "blake3"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "not": { "pattern": "(^/|^[A-Za-z]:|(^|[/\\\\])\\.\\.([/\\\\]|$))" } },
          "size": { "type": "integer", "minimum": 0 },
          "blake3": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "mediaType": { "type": "string" }
        }
      }
    }
  }
}
